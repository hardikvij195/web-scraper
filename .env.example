# Copy to .env. All optional — CLI flags override.

# Seconds between place visits (base; ±40% jitter is added). 6 = ~8-10 places/min, safe from a home IP.
SCRAPE_DELAY_SEC=6
# Long pause every N places, and how long (seconds, randomised 0.7x–1.3x).
SCRAPE_PAUSE_EVERY=50
SCRAPE_PAUSE_SEC=45
# Default country for phone parsing / WhatsApp mobile heuristic (ISO alpha-2).
DEFAULT_COUNTRY=IN
# Headless browser (true/false). Use false the first time to watch it work.
HEADLESS=true
# Optional proxy for the Google Maps step only, e.g. socks5://127.0.0.1:1080 or http://user:pass@host:port
MAPS_PROXY=
# Website enrichment concurrency (each business's own site — not Google; safe to raise).
ENRICH_CONCURRENCY=5
# SQLite path
DB_PATH=data/leads.db
# Optional: enables the AI "suggest keywords" button in the web UI (either one).
# Without a key it falls back to Google autosuggest (still works, less smart).
GROQ_API_KEY=
OPENAI_API_KEY=
