# Copy to .env. All optional — CLI flags override.

# Seconds between place visits (base; ±40% jitter is added). 6 = ~8-10 places/min, safe from a home IP.
SCRAPE_DELAY_SEC=6
# Long pause every N places, and how long (seconds, randomised 0.7x–1.3x).
SCRAPE_PAUSE_EVERY=50
SCRAPE_PAUSE_SEC=45
# Default country for phone parsing / WhatsApp mobile heuristic (ISO alpha-2).
DEFAULT_COUNTRY=IN
# Headless browser (true/false). Use false the first time to watch it work.
HEADLESS=true
# Optional proxy for the Google Maps step only, e.g. socks5://127.0.0.1:1080 or http://user:pass@host:port
MAPS_PROXY=
# Website enrichment concurrency (each business's own site — not Google; safe to raise).
ENRICH_CONCURRENCY=5
# ── enrichment anti-bot tiers (W12/W13/W15). All optional; nothing changes when unset. ──
# TLS-impersonation retry (curl_cffi, Chrome fingerprint) between httpx and the browser.
ENRICH_TLS_IMPERSONATE=true
# ONE proxy for the curl_cffi + browser tiers (W13). http://user:pass@host:port
ENRICH_PROXY=
# A LIST of proxies (W15) — comma/newline-separated, user:pass@host:port ok. Supersedes
# ENRICH_PROXY. Round-robin per attempt; a proxy that 407s or cannot be reached
# ENRICH_PROXY_MAX_FAILURES times in a row is benched for ENRICH_PROXY_COOLDOWN_SEC.
ENRICH_PROXIES=
# 1 = try a proxy BEFORE the own-IP attempt (for a VPS / datacenter IP). Default: direct first.
ENRICH_PROXY_FIRST=0
ENRICH_PROXY_MAX_FAILURES=3
ENRICH_PROXY_COOLDOWN_SEC=300
# W22: press Cloudflare's managed/interactive Turnstile checkbox ourselves in the browser
# tier (bench: +3/19 sites). Default ON (user directive 2026-08-25). 0 = only classify and
# report the wall as enrich_error=cf_managed / cf_interactive.
ENRICH_CF_CLICK=1
# W22: 1 = after real Chrome also fails on a block, try once more through Camoufox (a
# fingerprint-rewritten Firefox; `pip install camoufox` + `camoufox fetch`). Fingerprint is
# frozen in data/camoufox-profile/camoufox-opts.json. Bench: +0 on the job #7 set — off.
ENRICH_BROWSER_CAMOUFOX=0
# SQLite path
DB_PATH=data/leads.db

# ── job time budget: how a job's "max minutes" is split between its phases ────────────
# A job runs Google Maps discovery first, then researches what it found (website,
# LinkedIn, Instagram, Facebook, WhatsApp, AI summary).
#
# Default reading: "max minutes" is the GOOGLE MAPS CAP. A 30-minute job spends up to
# 30 min on Maps, then up to 15 more (0.5x) on research. Total worst case 45 min.
#   MAPS_BUDGET_FRAC=1.0  ENRICH_BUDGET_FRAC=0.5
# Other reading — the 30 minutes covers the WHOLE run (21 min Maps + 9 min research):
#   MAPS_BUDGET_FRAC=0.7  ENRICH_BUDGET_FRAC=0.3
MAPS_BUDGET_FRAC=1.0
# Fraction of "max minutes" the research phases get. 0 = never time them out.
ENRICH_BUDGET_FRAC=0.5
# Fraction of the MAPS budget spent collecting result links before opening any place.
# A wide radius tiles into thousands of searches; without this the run collects links
# until the clock runs out and scrapes nothing.
COLLECT_BUDGET_FRAC=0.4
# How many past runs of a phase feed its rolling seconds-per-unit average (the ETA).
# Until a phase has run at least once, the UI shows "estimating…" rather than a guess.
ETA_HISTORY_JOBS=20
# Optional: enables the AI "suggest keywords" button in the web UI (either one).
# Without a key it falls back to Google autosuggest (still works, less smart).
GROQ_API_KEY=
OPENAI_API_KEY=

# WhatsApp verification: checks per account per day. 0 = no cap (default since 2026-08-25, user directive).
WA_DAILY_CAP=0

# Pause between checking one number and the next, in seconds — a random value in
# this range each time. Lowered from 8-20 to 3-8 on 2026-09-01 (~250 -> ~650
# numbers an hour). Raise both if an account starts getting challenged; the
# randomness matters more than the rate, so keep min and max apart.
WA_VERIFY_DELAY_MIN=3
WA_VERIFY_DELAY_MAX=8
